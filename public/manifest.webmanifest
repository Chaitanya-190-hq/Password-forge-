{
  "id": "./",
  "name": "Password Forge — Cryptography Workstation",
  "short_name": "Password Forge",
  "description": "Local-first cryptography workstation: generate, inspect, encrypt, hash and store secrets without a backend.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#111216",
  "theme_color": "#111216",
